# ============================================================================
# Vin Eyewear — biến môi trường
#
# Chép file này thành `.env` rồi điền giá trị thật:
#     cp .env.example .env
#
# `.env` đã nằm trong .gitignore — KHÔNG commit file đó lên git.
# Chỉ file .env.example này (không chứa giá trị thật) được theo dõi.
# ============================================================================

# --- Ứng dụng ---------------------------------------------------------------
# APP_ENV: local | production
#   local      -> hiện lỗi chi tiết ra màn hình, tiện sửa bug
#   production -> giấu lỗi, chỉ ghi vào log. Bắt buộc dùng khi lên server thật.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Song ngữ: widget dịch Elfsight ------------------------------------------
#
# ĐỂ TRỐNG = KHÔNG NHÚNG GÌ. Site thuần tiếng Việt, không một request nào ra
# static.elfsight.com. Trên máy dev cứ để trống — xem lý do ngay dưới.
#
# Lấy mã: elfsight.com -> tạo widget "Website Translator" -> đoạn nhúng họ sinh
# ra có dạng <div class="elfsight-app-1ac7608f-e549-4325-bed8-08f5b5..."></div>
# Chép ĐÚNG chuỗi sau "elfsight-app-", không chép cả class, không chép cả thẻ.
#
# Trong trình soạn của Elfsight nhớ chọn kiểu hiển thị NỔI (floating). Chọn
# inline thì widget rơi xuống đáy trang, dưới cả chân trang, gần như không ai
# thấy — vì thẻ div được in ở cuối <body>.
#
# HẠN MỨC: gói miễn phí 200 lượt xem/tháng, vượt là Elfsight tắt widget tới đầu
# tháng sau (trang vẫn chạy, chỉ mất nút đổi ngôn ngữ). Máy dev mà cũng khai mã
# này là đang đốt hạn mức của trang thật bằng những lần F5 lúc sửa code.
ELFSIGHT_WIDGET_ID=

# --- Cơ sở dữ liệu ----------------------------------------------------------
#
# TRÊN MÁY: giữ nguyên như dưới, database/setup.sh tự điền.
#
# TRÊN HOSTING DÙNG CHUNG (InfinityFree, cPanel…): bốn giá trị này lấy ở
# bảng điều khiển, mục "MySQL Databases". Lưu ý ba điểm hay sai:
#
#   DB_HOST  KHÔNG phải localhost. InfinityFree cho host dạng
#            sqlXXX.infinityfree.com — chép đúng chuỗi hosting hiển thị.
#   DB_NAME  có tiền tố tài khoản, ví dụ if0_12345678_vineyewear
#   DB_USER  cũng có tiền tố đó, thường trùng phần đầu với DB_NAME
#
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vin_eyewear
DB_USER=vin_eyewear
DB_PASS=

# --- Cài đặt lần đầu --------------------------------------------------------
#
# CHỈ dùng trên hosting không có SSH, để chạy install.php tạo tài khoản quản trị.
# Đặt một chuỗi ngẫu nhiên dài (20+ ký tự) do bạn tự nghĩ ra, rồi mở:
#     https://ten-mien-cua-ban/install.php?token=<chuỗi đó>
#
# XOÁ install.php sau khi cài xong. Để trống dòng này thì install.php từ chối chạy.
INSTALL_TOKEN=

# --- Đăng nhập bằng Google ---------------------------------------------------
#
# Để trống thì nút "Tiếp tục với Google" ở trang /auth KHÔNG hiện ra — site vẫn
# chạy bình thường với đăng ký bằng số điện thoại.
#
# Lấy ở console.cloud.google.com -> APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application. Xem hướng dẫn từng
# bước trong config/auth.php.
#
# "Authorized redirect URIs" trong Google phải khớp TỪNG KÝ TỰ với APP_URL ở
# trên cộng /auth/google/callback. Ví dụ:
#     https://vreyewear.gt.tc/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phiên đăng nhập --------------------------------------------------------
#
# Cookie phiên nay LUÔN hết khi đóng trình duyệt. Muốn giữ đăng nhập lâu thì
# người dùng tự tick "Ghi nhớ đăng nhập" ở trang /auth — khi đó site cấp một
# token riêng sống 30 ngày, thu hồi được, lưu trong bảng remember_tokens.
#
# Giá trị dưới đây chỉ còn quyết định dữ liệu phiên sống bao lâu TRÊN MÁY CHỦ
# (session.gc_maxlifetime), tính bằng giây. Mặc định 2 tuần.
SESSION_LIFETIME=1209600

# --- Mốc tính doanh thu ------------------------------------------------------
#
# Bảng Tổng quan chỉ cộng tiền của đơn đặt TỪ mốc này. Để trống = tính toàn bộ.
#
# Dùng khi cửa hàng đã chạy thử một thời gian và đơn thử nằm lẫn với đơn thật:
# đặt mốc bằng ngày mở bán thật là doanh thu bắt đầu lại từ 0 mà KHÔNG xoá đơn
# nào — đơn cũ vẫn tra cứu được đầy đủ ở /quan-tri/don-hang.
#
# Định dạng 'YYYY-MM-DD' hoặc 'YYYY-MM-DD HH:MM:SS'. Gõ sai định dạng thì mốc
# bị bỏ qua (ghi một dòng vào error log) và bảng hiện số liệu toàn bộ — dòng
# dẫn trên đầu trang Tổng quan luôn nói rõ đang tính từ đâu, nên nhìn là biết
# mốc đã ăn hay chưa.
#
# CHỈ áp cho hai ô tiền. Các ô hàng chờ (đơn mới, lịch hẹn chờ) không lọc theo
# mốc — chúng đếm việc còn phải làm, và một đơn từ tháng trước chưa ai xác nhận
# thì vẫn là việc chưa xong.
STATS_SINCE=

# --- Gửi email --------------------------------------------------------------
#
# Dùng cho liên kết đặt lại mật khẩu (/quen-mat-khau).
#
#   log   KHÔNG gửi đi đâu, ghi ra storage/mail/ để xem khi phát triển
#   mail  dùng hàm mail() của PHP — cần hosting có sendmail (cPanel, VPS)
#   smtp  nối tới máy chủ SMTP bên ngoài (Gmail, Brevo, SendGrid…)
#
# INFINITYFREE BẢN MIỄN PHÍ CHẶN CẢ HAI: hàm mail() bị vô hiệu hoá và cổng SMTP
# ra ngoài bị khoá. Trên hosting đó cứ để 'log'; luồng quên mật khẩu tự chuyển
# sang đường nhân viên xử lý ở /quan-tri/quen-mat-khau.
MAIL_DRIVER=log

MAIL_FROM_ADDRESS=no-reply@vineyewear.vn
MAIL_FROM_NAME="Vin Eyewear"

# Chỉ cần khi MAIL_DRIVER=smtp.
# Gmail: dùng "mật khẩu ứng dụng" (App Password), KHÔNG phải mật khẩu tài khoản.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls = STARTTLS (cổng 587) · ssl = mã hoá ngay (cổng 465)
MAIL_ENCRYPTION=tls

# --- Zalo (ZNS) -------------------------------------------------------------
#
# Hai việc đi chung một đường:
#   · MÃ OTP lúc khách đăng ký / quên mật khẩu  -> bắt buộc, không có thì
#     KHÁCH KHÔNG ĐĂNG KÝ ĐƯỢC trên production
#   · thông báo lịch hẹn cho cửa hàng           -> tiện, không bắt buộc
#
# Bốn giá trị dưới đây là điều kiện tối thiểu để tin đi thật. Thiếu bất kỳ cái
# nào thì mọi tin chỉ ghi ra error log. Hướng dẫn lấy từng giá trị nằm trong
# config/zalo.php.

# developers.zalo.me -> ứng dụng của bạn -> "Thông tin ứng dụng".
ZALO_APP_ID=
ZALO_APP_SECRET=

# refresh_token LẦN ĐẦU, lấy tay một lần qua màn hình cấp quyền OA.
# Từ lần làm mới đầu tiên, cặp token mới nằm ở storage/zalo/token.json và giá
# trị này đứng im — ứng dụng KHÔNG tự ghi vào .env.
ZALO_OA_REFRESH_TOKEN=

# Mã mẫu tin OTP đã được Zalo duyệt (zns.zalo.me -> Quản lý mẫu tin).
# Zalo có mẫu OTP dựng sẵn, duyệt nhanh nhất trong các loại.
ZALO_ZNS_TEMPLATE_OTP=

# Tên ô chứa mã trong mẫu đó. Mẫu dựng sẵn của Zalo dùng `otp`; mẫu tự soạn
# đặt tên khác thì sửa ở đây, sai tên là Zalo từ chối cả tin.
ZALO_ZNS_OTP_PARAM=otp

# Số nhận thông báo lịch hẹn nội bộ. Đây KHÔNG phải số in trên web (số đó ở
# config/company.php) — có thể là số của máy trực.
ZALO_SHOP_PHONE=0366599711

# Gửi cả cho khách? ZNS tính phí theo tin và cần mẫu riêng, nên mặc định tắt.
ZALO_NOTIFY_CUSTOMER=false

# Mẫu tin lịch hẹn — mẫu TỰ SOẠN, tên các ô phải khớp Zalo::appointmentParams().
ZALO_ZNS_TEMPLATE_SHOP=
ZALO_ZNS_TEMPLATE_CUSTOMER=

# Mẫu tin ĐƠN HÀNG MỚI — gửi cửa hàng. Bảy ô: ma_don, khach_hang, dien_thoai,
# nhan_hang, thanh_toan, tong_tien, san_pham (xem Zalo::orderParams()).
# Để trống thì đơn vẫn đặt được, tin báo rơi xuống error log.
ZALO_ZNS_TEMPLATE_ORDER=

# Mẫu tin YÊU CẦU LIÊN HỆ — gửi CSKH. Bốn ô: khach_hang, dien_thoai, email,
# noi_dung (xem Zalo::contactParams()).
#
# ⚠️ ĐỂ TRỐNG CÓ HẬU QUẢ NẶNG HƠN ba mẫu trên. Lịch hẹn và đơn hàng vẫn nằm
# trong khu quản trị với hàng chờ riêng để nhân viên mở ra xem; yêu cầu liên hệ
# thì KHÔNG — trang /quan-tri/lien-he đã bỏ cột trạng thái và thành sổ lưu trữ
# thuần. Chưa khai mẫu này nghĩa là mọi yêu cầu chỉ nằm trong error log, và
# nhân viên phải bấm "Gửi sang Zalo" từng cái.
ZALO_ZNS_TEMPLATE_CONTACT=

# Số Zalo của CSKH. ĐỂ TRỐNG THÌ RƠI VỀ ZALO_SHOP_PHONE ở trên, không phải tắt
# tính năng. Chỉ khai khi bộ phận CSKH có máy trực riêng — lúc đó thông báo
# lịch hẹn và đơn hàng vẫn về máy quầy, còn câu hỏi của khách về máy CSKH.
ZALO_CSKH_PHONE=

# Đường lui khi thử nghiệm: một access_token còn hạn, khai tay. Sống ~25 giờ
# rồi chết, không có gì làm mới. Đừng dùng trên production.
ZALO_OA_ACCESS_TOKEN=

# --- SePay: đối soát chuyển khoản tự động ------------------------------------
# https://sepay.vn — đọc biến động số dư tài khoản ngân hàng của cửa hàng rồi
# báo về website, để đơn chuyển khoản tự sang "đã thanh toán" / "đã đặt cọc"
# mà không cần ai đối chiếu sao kê. Xem config/sepay.php.
#
# SỐ TÀI KHOẢN KHÔNG KHAI Ở ĐÂY — nó nằm ở config/company.php -> 'bank', dùng
# chung cho cả mã QR lẫn webhook. Khai hai chỗ là ngày đổi tài khoản sẽ sửa
# một chỗ quên chỗ kia.

# Bật/tắt. Tắt thì webhook đóng và giao diện không hứa xác nhận tự động.
SEPAY_ENABLED=false

# Khoá xác thực webhook — chuỗi ngẫu nhiên DO BẠN ĐẶT trên trang cấu hình của
# SePay, không phải thứ SePay cấp. SePay gửi kèm dạng: Authorization: Apikey <khoá>
# Để trống = webhook trả 403 cho mọi request. Sinh khoá:  openssl rand -hex 32
SEPAY_WEBHOOK_KEY=

# Kiểu ảnh QR: để trống | compact | qronly | standee
SEPAY_QR_TEMPLATE=qronly

# --- SePay: cầu nối trên Render ----------------------------------------------
#
# VÌ SAO CẦN: InfinityFree bản miễn phí đặt một lớp chống bot TRƯỚC Apache. Máy
# chủ SePay không chạy JavaScript nên không qua nổi lớp đó — webhook gửi thẳng
# vào /webhook/sepay KHÔNG BAO GIỜ tới nơi, và không để lại dấu vết nào để lần.
#
# Cầu nối (mã nguồn trong relay/, chạy trên Render) nhận webhook thay, rồi đưa
# giao dịch về đây bằng hai đường: nó ĐẨY sang, và website tự KÉO về. Hai giá
# trị dưới đây chỉ phục vụ đường KÉO — đường không thể hỏng.
#
# Để trống cả hai = tắt đường kéo. Website vẫn nhận được đường đẩy, chỉ là mất
# lưới an toàn. Hướng dẫn dựng cầu nối: relay/README.md.

# Địa chỉ gốc của dịch vụ trên Render, KHÔNG kèm /api/keo.
SEPAY_RELAY_URL=

# Khoá đường kéo — bằng PULL_KEY khai bên Render. PHẢI KHÁC SEPAY_WEBHOOK_KEY:
# ba chặng (SePay -> cầu nối -> website, và website -> cầu nối) là ba khoá.
# Sinh khoá:  openssl rand -hex 32
SEPAY_RELAY_KEY=

# Giây nghỉ tối thiểu giữa hai lượt kéo. Để trống là 3.
SEPAY_RELAY_INTERVAL=3
