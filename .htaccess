# ============================================================================
# Vin Eyewear — cấu hình Apache
#
# Dự án đặt mã nguồn CÙNG CẤP với thư mục gốc web (không có public/ riêng),
# nên mọi file trong repo về nguyên tắc đều nằm trong tầm với của trình duyệt.
# Khối CHẶN TRUY CẬP bên dưới là thứ duy nhất ngăn điều đó — đừng gỡ.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CHẶN TRUY CẬP FILE NHẠY CẢM
#
# Luật rewrite ở mục 2 có điều kiện `!-f` (bỏ qua file có thật), nên file tồn
# tại được Apache trả về NGUYÊN VĂN mà không đi qua index.php. Không có khối
# này thì https://site/.env trả thẳng mật khẩu database dưới dạng văn bản
# thuần, và https://site/database/schema.sql phơi toàn bộ cấu trúc CSDL.
#
# Đặt TRƯỚC mọi luật khác để không luật nào lách qua được.
# ----------------------------------------------------------------------------

# Mọi file bắt đầu bằng dấu chấm: .env, .gitignore, .htaccess, .ftpignore…
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Đuôi file không bao giờ được phục vụ trực tiếp
<FilesMatch "\.(sql|md|sh|log|lock|example|ini|yml|yaml|bak|old|orig|swp|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Thư mục mã nguồn — chỉ index.php ở gốc được chạy trực tiếp.
# Chặn cả .php: file trong core/ và app/ được include từ index.php, gọi thẳng
# qua URL chỉ gây lỗi (thiếu hằng ROOT_PATH) hoặc chạy code ngoài ngữ cảnh.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|core|config|database|docs|scripts|storage)/ - [F,L]
</IfModule>

# ----------------------------------------------------------------------------
# 2. ĐIỀU HƯỚNG — mọi đường dẫn không phải file/thư mục có thật đều về index.php
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ĐƯA HEADER `Authorization` VÀO PHP.
    #
    # Apache chạy PHP dưới CGI/FastCGI KHÔNG truyền header này xuống, vì nó là
    # thứ Apache tự giữ lại cho phần xác thực của chính nó. Hệ quả: webhook của
    # SePay gửi `Authorization: Apikey ...` mà $_SERVER không có gì cả, và mọi
    # request bị trả 403 — không có lỗi nào để lần, chỉ là im lặng từ chối.
    #
    # Dòng dưới chép nó sang HTTP_AUTHORIZATION. Máy chủ nào đã truyền sẵn thì
    # dòng này chỉ ghi lại đúng giá trị cũ, không hại gì.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/assets/
    # KHÔNG nhét đường dẫn vào tham số nào cả.
    #
    # Bản trước viết `index.php?q=$1`, mà `q` lại đúng là tên ô TÌM KIẾM của
    # site — nên mọi request đều tự mang theo một từ khoá tìm kiếm bằng chính
    # đường dẫn của nó, và bốn chỗ đọc $_GET['q'] đều hiểu nhầm:
    #
    #   /san-pham            -> lọc danh sách theo chữ "san-pham"  -> LUÔN RỖNG
    #   /quan-tri/san-pham   -> danh sách sản phẩm khu quản trị cũng rỗng
    #   /tim-kiem            -> tìm chữ "tim-kiem" thay vì hiện trạng thái trống
    #   mọi trang            -> ô tìm kiếm trên header hiện sẵn tên đường dẫn
    #
    # Bỏ hẳn tham số chứ không đổi tên nó: Router đọc đường dẫn từ REQUEST_URI
    # (core/Router.php), vốn được mod_rewrite giữ nguyên qua chuyển hướng nội
    # bộ, nên không có ai cần tới nó. Thêm một tham số không ai đọc thì sớm
    # muộn cũng lại va vào tên thật của một ô nhập nào đó.
    RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>

# ----------------------------------------------------------------------------
# 3. HEADER BẢO MẬT
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Trình duyệt không được tự đoán kiểu nội dung khác với Content-Type khai báo
    Header set X-Content-Type-Options "nosniff"

    # Không cho site khác nhúng trang này vào iframe (chống clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Chỉ gửi đường dẫn đầy đủ khi điều hướng trong cùng site; sang site khác
    # chỉ gửi tên miền, không lộ đường dẫn người dùng vừa xem
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Trang này không dùng các API đó — tắt sẵn để script bên thứ ba
    # (nếu bị chèn) cũng không xin quyền được.
    # LƯU Ý: trang thử kính AR CẦN camera; nếu bật lại thì phải bỏ 'camera'
    # khỏi danh sách hoặc khai riêng cho đường dẫn /thu-ar.
    Header set Permissions-Policy "geolocation=(), microphone=(), payment=()"
</IfModule>

# ----------------------------------------------------------------------------
# 4. NÉN VÀ BỘ NHỚ ĐỆM
#
# Trước khối này KHÔNG CÓ GÌ CẢ: không nén, không header đệm. Mỗi lần mở một
# trang quản trị là tải lại từ đầu khoảng 258 KB, trong đó riêng admin.css đã
# 161 KB. Trên gói hosting miễn phí, quãng ấy dài hơn hẳn phần máy chủ dựng
# trang — tức là tối ưu truy vấn bao nhiêu cũng không thấy, vì nút thắt nằm ở
# đường truyền.
#
# Đo trên chính các file của dự án:
#
#     admin.css        161,5 KB → 45,2 KB   (−72%)
#     admin-orders.css  34,3 KB → 10,8 KB   (−69%)
#     admin-modal.js    29,6 KB →  9,0 KB   (−70%)
#     layout.css        26,5 KB →  9,3 KB   (−65%)
#     một trang HTML    29,5 KB →  3,5 KB   (−89%)
#
# CSS viết tay kèm chú thích dài thì nén rất tốt — đó là lý do con số ở đây
# lớn hơn mức thường thấy, và cũng là lý do KHÔNG cần rút gọn (minify) file:
# thêm một bước build là phá ràng buộc "kéo mã về là chạy" của dự án, mà đổi
# lại chỉ vài KB sau khi đã nén.
#
# Mọi thứ bọc trong <IfModule>: hosting nào không bật hai module này thì các
# luật bị bỏ qua, trang vẫn chạy y như trước.
# ----------------------------------------------------------------------------

# KIỂU NỘI DUNG CỦA .js PHẢI KHAI LẠI Ở ĐÂY.
#
# Bộ mime.types của Apache trong XAMPP (và của không ít hosting chia sẻ) vẫn
# khai `.js` là `application/x-javascript` — một tên cũ từ trước khi có chuẩn.
# Hai khối bên dưới lọc theo KIỂU NỘI DUNG, nên tên lạ là JS không được nén và
# không được đệm: đo thật trên Apache 2.4.58 của máy này, admin-modal.js ra
# đúng 30.310 byte cả khi trình duyệt đã xin gzip.
#
# Khai lại ở đây thì mọi máy chủ đều trả cùng một tên, và hai khối kia bắt
# được. Vẫn liệt kê cả tên cũ ở dưới phòng khi host cấm AddType.
<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType image/svg+xml   .svg
    AddType font/woff2      .woff2
</IfModule>

<IfModule mod_deflate.c>
    # Chỉ nén văn bản. Ảnh JPEG/PNG/WebP đã nén sẵn, nén lần nữa chỉ tốn CPU
    # mà file còn to hơn.
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
        AddOutputFilterByType DEFLATE text/javascript application/javascript
        AddOutputFilterByType DEFLATE application/x-javascript
        AddOutputFilterByType DEFLATE application/json application/xml
        AddOutputFilterByType DEFLATE image/svg+xml
        AddOutputFilterByType DEFLATE font/ttf font/otf
    </IfModule>
</IfModule>

# ĐỆM BẰNG mod_headers, KHÔNG PHẢI mod_expires.
#
# Hai module cho ra cùng kết quả, nhưng chúng nằm ở HAI NHÓM AllowOverride khác
# nhau: ExpiresActive thuộc nhóm `Indexes`, còn `Header set` thuộc nhóm
# `FileInfo`. Trên hosting chia sẻ, một directive nằm ngoài nhóm được cho phép
# KHÔNG bị bỏ qua — nó làm cả site trả 500. Mà .htaccess này đã dùng `Header
# set` ở mục 3 và site đang chạy thật, tức là `FileInfo` chắc chắn được phép;
# `Indexes` thì chưa có gì chứng minh. Không đánh đổi cả site lấy một header.
<IfModule mod_headers.c>
    # MỘT NĂM CHO CSS VÀ JS LÀ AN TOÀN, vì asset() gắn ?v=<filemtime> vào mọi
    # đường dẫn (core/helpers.php) — sửa file là đường dẫn đổi, trình duyệt coi
    # như một file khác và tải lại ngay. Không có chỗ nào trong app/views trỏ
    # thẳng /assets/... mà không đi qua asset(); đã soát lại khi thêm khối này.
    # Nếu sau này có, phải hạ con số dưới đây xuống.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # ẢNH VÀ FONT CHỈ 30 NGÀY, không phải một năm: ảnh được CSS gọi thẳng bằng
    # url(...) nên KHÔNG có ?v= nào cả. Thay một tấm ảnh mà đệm cả năm thì máy
    # đã từng mở trang sẽ giữ ảnh cũ tới hết năm, và không có cách nào bảo nó
    # tải lại ngoài việc đổi tên file.
    <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|ico|svg|woff2|woff|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # KHÔNG có luật nào cho HTML. Mọi trang ở đây đều dựng theo phiên đăng
    # nhập — một trang quản trị nằm lại trong đệm là dữ liệu của người này hiện
    # ra cho lượt xem sau.
</IfModule>

# ----------------------------------------------------------------------------
# 5. KHÁC
# ----------------------------------------------------------------------------

# Không liệt kê nội dung thư mục khi không có index
Options -Indexes

# Chặn truy cập file .htaccess và .htpasswd (bổ sung cho luật dotfile ở trên)
<FilesMatch "^\.ht">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
