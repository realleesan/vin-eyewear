# =============================================================================
# Biến môi trường của cầu nối. Trên Render KHÔNG dùng file này — khai ở
# dịch vụ -> Environment. File này để chạy thử dưới máy:
#
#     cd relay
#     cp .env.example .env && sửa giá trị
#     set -a && . ./.env && set +a && node server.js
#
# (Cầu nối cố ý KHÔNG tự đọc .env: Render truyền biến thẳng vào tiến trình, mà
#  thêm một cách nạp cấu hình nữa là thêm một chỗ để hai bên lệch nhau.)
# =============================================================================

# --- Chặng 1: SePay -> cầu nối ------------------------------------------------
# Chuỗi ngẫu nhiên DO BẠN ĐẶT, rồi dán y hệt vào my.sepay.vn -> Webhooks ->
# Xác thực: API Key. Sinh khoá:  openssl rand -hex 32
# Để trống = cầu nối trả 403 cho mọi request.
SEPAY_WEBHOOK_KEY=

# --- Chặng 2: cầu nối -> website ----------------------------------------------
# Địa chỉ webhook thật trên InfinityFree.
SITE_WEBHOOK_URL=https://vreyewear.gt.tc/webhook/sepay

# Khoá website đợi — chính là SEPAY_WEBHOOK_KEY trong .env TRÊN HOSTING.
# NÊN KHÁC khoá chặng 1. Để trống thì dùng lại khoá chặng 1.
SITE_WEBHOOK_KEY=

# --- Chặng 3: website -> cầu nối (đường kéo) ----------------------------------
# Khoá website dùng để lấy hàng đợi về. Bằng SEPAY_RELAY_KEY trong .env trên
# hosting. Để trống = tắt đường kéo, chỉ còn đường đẩy (KHÔNG nên: đường đẩy
# là đường có thể hỏng, đường kéo là đường không hỏng).
PULL_KEY=

# --- Tuỳ chọn ------------------------------------------------------------------
# Nơi ghi hàng đợi. Trên Render free để /tmp/... (đĩa tạm).
DATA_DIR=./data

# false (mặc định) = đẩy hỏng thì trả 500 để SePay gửi lại. Xem lib/cau-hinh.js.
QUEUE_ACK=false

# Chỉ nhận webhook từ các IP này, ngăn cách bằng dấu phẩy. Để trống = không lọc
# (mặc định, và là lựa chọn đúng cho tới khi có lý do khác).
SEPAY_IPS=

# Số giao dịch tối đa giữ trong hàng đợi, và hạn giờ (giây) mỗi lần gọi sang
# InfinityFree.
QUEUE_MAX=500
SITE_TIMEOUT=20
